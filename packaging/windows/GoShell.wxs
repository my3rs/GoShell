<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="GoShell" Manufacturer="GoShell" Version="$(var.Version)" UpgradeCode="6D71B7C3-7A2D-4D80-9AF8-5A5DAAF2C0B7">
    <MajorUpgrade DowngradeErrorMessage="A newer version of GoShell is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GoShell">
        <!-- 每个组件只包含一个文件，满足 WiX 自动生成 Guid 的规则 -->
        <Component Id="MainComponent" Guid="*">
          <File Source="$(var.SourceDir)\GoShell.exe" KeyPath="yes" />
        </Component>
        <Component Id="TerminalEngineComponent" Guid="*">
          <File Source="$(var.SourceDir)\ghostty-vt.dll" KeyPath="yes" />
        </Component>
        <Component Id="BusyboxComponent" Guid="*">
          <File Source="$(var.SourceDir)\busybox.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="GoShell" Level="1">
      <ComponentRef Id="MainComponent" />
      <ComponentRef Id="TerminalEngineComponent" />
      <ComponentRef Id="BusyboxComponent" />
    </Feature>
  </Package>
</Wix>
